post_install() {
    /usr/bin/adblock browser install --system >/dev/null 2>&1 || true
    echo "AdBlock installed. Turn protection on with:  sudo adblock enable"
}
post_upgrade() {
    systemctl try-restart adblock.service >/dev/null 2>&1 || true
}
pre_remove() {
    /usr/bin/adblock disable >/dev/null 2>&1 || true
    /usr/bin/adblock browser uninstall --system >/dev/null 2>&1 || true
}
