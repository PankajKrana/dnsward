# Maintainer: AdBlock maintainers <maintainers@example.com>
pkgname=adblock
pkgver=0.1.1
pkgrel=1
pkgdesc="System-wide ad and tracker blocking (filtering DNS resolver + browser extensions)"
arch=('x86_64' 'aarch64')
url="https://github.com/PankajKrana/dnsward"
license=('MIT')
depends=('systemd' 'gcc-libs')
makedepends=('cargo' 'clang')
backup=('etc/adblock/config.toml')
install=adblock.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3bc776235efd8ca78f29f8655b0127fdc28e30143a7d7f6783e92c80c0e64934')

prepare() {
    cd "dnsward-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "dnsward-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release -p adblock-cli
}

check() {
    cd "dnsward-$pkgver"
    cargo test --frozen --workspace --lib
}

package() {
    cd "dnsward-$pkgver"
    install -Dm0755 target/release/adblock "$pkgdir/usr/bin/adblock"
    ln -s adblock "$pkgdir/usr/bin/adblock-native-host"
    install -dm0755 "$pkgdir/usr/share/adblock/filters"
    install -m0644 filters/*.txt "$pkgdir/usr/share/adblock/filters/"
    sh browser/build.sh >/dev/null
    cp -R browser/dist/chromium browser/dist/firefox "$pkgdir/usr/share/adblock/"
    install -dm0755 "$pkgdir/usr/lib/systemd/system"
    sed 's#/usr/local/bin/adblock#/usr/bin/adblock#g' platforms/linux/adblock.service > "$pkgdir/usr/lib/systemd/system/adblock.service"
    install -Dm0644 crates/adblock-config/src/default-config.toml "$pkgdir/etc/adblock/config.toml"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    echo 'u adblock - "AdBlock DNS service" /var/lib/adblock' | install -Dm0644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/adblock.conf"
    echo 'd /var/lib/adblock 0755 root root -
d /var/lib/adblock/data 0755 adblock adblock -' | install -Dm0644 /dev/stdin "$pkgdir/usr/lib/tmpfiles.d/adblock.conf"
}
