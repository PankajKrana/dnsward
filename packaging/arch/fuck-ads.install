post_install() {
    /usr/bin/fuck-ads browser install --system >/dev/null 2>&1 || true
    echo "FuckAds installed. Turn protection on with:  sudo fuck-ads enable"
}
post_upgrade() {
    systemctl try-restart fuck-ads.service >/dev/null 2>&1 || true
}
pre_remove() {
    /usr/bin/fuck-ads disable >/dev/null 2>&1 || true
    /usr/bin/fuck-ads browser uninstall --system >/dev/null 2>&1 || true
}
