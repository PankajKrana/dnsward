#!/bin/sh
set -e
# On removal (not upgrade), restore DNS settings and stop the service.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    /usr/bin/fuck-ads disable >/dev/null 2>&1 || systemctl disable --now fuck-ads.service >/dev/null 2>&1 || true
    /usr/bin/fuck-ads browser uninstall --system >/dev/null 2>&1 || true
fi
exit 0
