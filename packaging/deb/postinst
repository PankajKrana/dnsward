#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd adblock >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/adblock --shell /usr/sbin/nologin adblock >/dev/null
    fi
    install -d -m 0755 /var/lib/adblock
    install -d -m 0755 -o adblock -g adblock /var/lib/adblock/data
    systemctl daemon-reload >/dev/null 2>&1 || true
    /usr/bin/adblock browser install --system >/dev/null 2>&1 || true
    if systemctl is-active --quiet adblock.service; then
        systemctl restart adblock.service || true
    else
        echo "AdBlock installed. Turn protection on with:  sudo adblock enable"
    fi
fi
exit 0
