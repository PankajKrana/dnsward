#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd fuck-ads >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/fuck-ads --shell /usr/sbin/nologin fuck-ads >/dev/null
    fi
    install -d -m 0755 /var/lib/fuck-ads
    install -d -m 0755 -o fuck-ads -g fuck-ads /var/lib/fuck-ads/data
    systemctl daemon-reload >/dev/null 2>&1 || true
    /usr/bin/fuck-ads browser install --system >/dev/null 2>&1 || true
    if systemctl is-active --quiet fuck-ads.service; then
        systemctl restart fuck-ads.service || true
    else
        echo "FuckAds installed. Turn protection on with:  sudo fuck-ads enable"
    fi
fi
exit 0
