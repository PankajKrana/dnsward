{
  "manifest_version": 3,
  "name": "AdBlock",
  "version": "0.1.0",
  "description": "Blocks ads and trackers using the AdBlock system service. No data leaves your computer.",
  "browser_specific_settings": {
    "gecko": { "id": "adblock@adblock.local", "strict_min_version": "128.0" }
  },
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["resources/*"], "matches": ["<all_urls>"] }
  ],
  "background": { "scripts": ["scriptlets.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdBlock",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
